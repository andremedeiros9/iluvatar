# iluvatar.toml
#
# This file describes the API that `iluvatar generate` will build.
# Edit it, then run `iluvatar generate` from this directory.

[project]
name       = "{{.Name}}"
module     = "{{.Module}}"
go_version = "{{.GoVersion}}"
# architecture selects the generated code layout:
#   "vertical"   (default) groups each resource's model, repository, and
#                service together under internal/<resource>.
#   "horizontal" splits concerns into internal/domain, internal/services,
#                internal/rpc (protos), and internal/api (bootstrap/wiring).
architecture = "{{.Architecture}}"

[server]
# framework is reserved for future REST support and currently has no
# effect; only gRPC resources are generated today.
framework = "net/http"
# port is the gRPC server's listen port.
port = {{.Port}}

[database]
# Supported drivers: postgres, mysql, sqlite
driver = "{{.DatabaseDriver}}"
dsn    = ""

[ci]
# Supported providers: github, gitlab
provider = "{{.CIProvider}}"

[cloud]
# Supported providers: none, aws
# region is only read when provider = "aws".
provider = "{{.CloudProvider}}"
region   = "{{.CloudRegion}}"

# Define one [[resources]] block per CRUD resource you want generated.
# communication selects how this resource's endpoints are exposed. Only
# "grpc" is implemented today; "rest" and "rpc" are reserved for later.
# Each field's type is one of: string, int, float, bool, time, uuid.
# Every resource automatically gets a uuid id plus created_at/updated_at
# timestamps, so don't declare those yourself.
# Example:
#
# [[resources]]
# name          = "user"
# communication = "grpc"
#
#   [[resources.fields]]
#   name = "email"
#   type = "string"
#
#   [[resources.fields]]
#   name = "age"
#   type = "int"
