package api

import (
	"github.com/jmoiron/sqlx"
	"google.golang.org/grpc"
{{range .Resources}}
	service{{.PascalName}} "{{$.Module}}/internal/services/{{.PackageName}}"
	{{.PackageName}}pb "{{$.Module}}/internal/rpc/{{.PackageName}}/pb"
{{end}})

// New builds a gRPC server with every configured resource's service
// registered, wired to its domain repository and database connection.
func New(db *sqlx.DB) *grpc.Server {
	s := grpc.NewServer()

{{range .Resources}}	repo := service{{.PascalName}}.NewRepository(db)
	svc := service{{.PascalName}}.NewService(repo)
	{{.PackageName}}pb.Register{{.PascalName}}ServiceServer(s, svc)
{{end}}
	return s
}
