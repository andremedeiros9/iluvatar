services:
  app:
    build: .
    ports:
      - "{{.Port}}:{{.Port}}"
    env_file: .env
    depends_on:
      db:
        condition: service_healthy

  db:
    image: mysql:8
    env_file: .env
    volumes:
      - db-data:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h localhost -u$$MYSQL_USER -p$$MYSQL_PASSWORD"]
      interval: 5s
      timeout: 5s
      retries: 5

volumes:
  db-data:
