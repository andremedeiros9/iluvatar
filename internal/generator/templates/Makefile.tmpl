BINARY := {{.BinaryName}}
DIST   := .dist
{{- if eq .CloudProvider "aws"}}

AWS_REGION     ?= {{.CloudRegion}}
AWS_ACCOUNT_ID ?=
{{- end}}

.PHONY: build run test fmt vet lint vulns proto migrate-up migrate-down docker-build{{if eq .CloudProvider "aws"}} docker-login docker-push{{end}} clean

build:
	go build -o $(DIST)/$(BINARY) ./cmd/$(BINARY)

run:
	go run ./cmd/$(BINARY)

test:
	go test ./...

fmt:
	go fmt ./...

vet:
	go vet ./...

lint:
	golangci-lint run ./...

vulns:
	govulncheck ./...

# proto regenerates the *.pb.go/*_grpc.pb.go files from every resource's
# .proto. Requires protoc, protoc-gen-go, and protoc-gen-go-grpc installed
# locally; none of them are installed for you.
proto:
	protoc --go_out=. --go_opt=paths=source_relative --go-grpc_out=. --go-grpc_opt=paths=source_relative $$(find internal -name '*.proto')

# migrate-up/migrate-down apply/revert migrations/ with golang-migrate's
# `migrate` CLI, which isn't installed for you. DATABASE_DSN must be set.
migrate-up:
	migrate -path migrations -database "$$DATABASE_DSN" up

migrate-down:
	migrate -path migrations -database "$$DATABASE_DSN" down

docker-build:
	docker build -t $(BINARY) .
{{- if eq .CloudProvider "aws"}}

docker-login:
	aws ecr get-login-password --region $(AWS_REGION) | docker login --username AWS --password-stdin $(AWS_ACCOUNT_ID).dkr.ecr.$(AWS_REGION).amazonaws.com

docker-push: docker-build docker-login
	docker tag $(BINARY):latest $(AWS_ACCOUNT_ID).dkr.ecr.$(AWS_REGION).amazonaws.com/$(BINARY):latest
	docker push $(AWS_ACCOUNT_ID).dkr.ecr.$(AWS_REGION).amazonaws.com/$(BINARY):latest
{{- end}}

clean:
	rm -rf $(DIST)
